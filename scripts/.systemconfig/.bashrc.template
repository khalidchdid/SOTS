set -a
export SSL_CERT_FILE=__SSL_CERT_FILE_CA_BUNDLE_CRT__

export UV_PYTHON_INSTALL_MIRROR="https://nexus.framatome.corp/repository/python-build-standalone"
export UV_PYTHON_PREFERENCE="only-managed"
export UV_DEFAULT_INDEX="https://nexus.framatome.corp/repository/py-pypi/simple"
export UV_NATIVE_TLS="true"
export UV_HTTP_TIMEOUT=600
export UV_CACHE_DIR=~/.uv

if [ -f ~/.local/bin/env ]; then
    . ~/.local/bin/env
fi
